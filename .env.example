MYSQL_DATABASE=momfit
MYSQL_USER=momfit
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password

# 인증 (JWT_SECRET은 충분히 긴 무작위 값으로 설정한다. 예: openssl rand -hex 32)
JWT_SECRET=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# 로컬 개발(HTTP)에서 쿠키가 필요하면 false. 운영(HTTPS)은 true.
COOKIE_SECURE=true

# 이메일 인증 메일 발송. 개발은 MAIL_BACKEND=console(코드를 서버 로그에 출력), 운영은 smtp.
# Gmail 예: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USERNAME=계정 주소, MAIL_FROM=계정 주소,
# SMTP_PASSWORD=Google 계정의 앱 비밀번호 (2단계 인증 필요, 계정 비밀번호가 아님)
MAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=change_me
MAIL_FROM=

# 카카오 로그인 (https://developers.kakao.com 에서 앱을 만들고 발급)
# - KAKAO_CLIENT_ID: REST API 키, KAKAO_CLIENT_SECRET: 카카오 로그인 > 보안의 Client Secret
# - KAKAO_REDIRECT_URI: 콘솔에 등록한 Redirect URI와 같아야 하며 프록시를 거치는 프론트 주소 기준
#   예) http://localhost:5174/api/auth/kakao/callback
# - KAKAO_ADMIN_KEY: 회원 탈퇴 시 카카오 연결 해제에 쓰는 어드민 키 (없으면 연결 해제를 건너뜀)
# - 동의 항목에서 닉네임(profile_nickname)을 켜야 한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=change_me
KAKAO_REDIRECT_URI=
KAKAO_ADMIN_KEY=change_me
# 카카오 로그인 후 돌아갈 프론트 주소. 비워 두면 같은 도메인의 상대 경로로 이동한다.
FRONTEND_URL=

# 회원 탈퇴 유예: 탈퇴 후 이 기간(일) 동안 데이터를 그대로 두고 로그인해서 복구할 수 있다. 기간이 지나면 완전히 삭제한다.
ACCOUNT_GRACE_DAYS=30
# 유예 기간이 지난 계정을 서버가 삭제하는 주기(시간). 0이면 서버의 주기 작업을 끄고
# `python -m scripts.purge_withdrawn`을 cron 등으로 직접 실행한다.
ACCOUNT_PURGE_INTERVAL_HOURS=6

# AI 에이전트 (오늘의 운동 리포트). 자세한 설명은 services/agent/README.md
# 운동 기록을 어디서 읽을지. fixture=services/agent/fixtures의 데모 기록, db=팀 테이블.
# 팀 테이블에 실제 기록이 없는 개발 환경을 위해 기본은 fixture다. 팀 테이블을 읽으려면 db로 바꾼다.
AGENT_DATA_SOURCE=fixture
# fixture 모드에서 쓸 시나리오. services/agent/fixtures/scenario_{이름}.json
# evaluated=판정이 채워진 뒤, not_evaluated_scored=판정 없이 점수만, not_evaluated_unscored=점수도 없음
AGENT_FIXTURE_SCENARIO=evaluated
# 문장을 쓰는 LLM 제공자. mock=API 키 없이 규칙으로 생성, anthropic=개발·운영용, gemini=무료 등급 비교용(가짜 데이터만)
AGENT_LLM_PROVIDER=mock
# 비워 두면 제공자별 기본 모델을 쓴다. (gemini: gemini-3.8-flash, anthropic: claude-haiku-5-5)
AGENT_LLM_MODEL=
# LLM 호출 하나의 제한 시간(초)
AGENT_LLM_TIMEOUT_SECONDS=10
# 리포트 하나가 LLM에 쓸 수 있는 전체 제한 시간(초)
AGENT_REPORT_TIMEOUT_SECONDS=25
# dev | prod. prod에서 허용 목록에 없는 제공자를 쓰면 에이전트 API만 503으로 막는다.
AGENT_APP_ENV=dev
AGENT_PROD_PROVIDERS=anthropic
# LLM API 키. 쓰는 제공자의 키만 채우면 된다.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 챗봇 서비스 주소. /api/chat/*을 이 주소로 전달한다. 비워 두면 클러스터 Service 주소를 쓴다.
# 로컬에서 챗봇을 따로 띄웠다면 http://localhost:8100
CHATBOT_URL=
# 챗봇 응답을 기다리는 제한 시간(초). 답변 생성(LLM 호출)에 수 초가 걸린다.
CHATBOT_TIMEOUT_SECONDS=60
